# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Firebase web app settings (Firebase console > Project settings > General)
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
FIREBASE_APP_ID="your-app-id"

# Complete service-account JSON on one line (Firebase console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT=

PORT=5000
