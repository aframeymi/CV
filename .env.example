# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Firebase Web API key, used to sign users in (Firebase console > Project settings > General)
FIREBASE_API_KEY="your-firebase-api-key"

# Complete service-account JSON on one line (Firebase console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT=

# Random secret that signs the CSRF tokens, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value for every environment, and keep it secret.
CSRF_SECRET=

# Number of proxies in front of the app that add to X-Forwarded-For. Leave unset locally (1).
# On Render it is 3: Cloudflare and two Render proxies.
# TRUST_PROXY_HOPS=1

PORT=5000
