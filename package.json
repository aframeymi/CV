{
  "name": "cv",
  "version": "1.0.0",
  "description": "This project aims to creat a platform where citizens of Berlin can report city infrastructural problems that they see in their everyday life to the municipality.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "lint": "eslint . --max-warnings=0",
    "prisma:seed": "prisma db seed",
    "prisma:seed:demo": "prisma db seed -- --demo",
    "deploy:prepare": "prisma generate && prisma migrate deploy && npm run prisma:seed"
  },
  "engines": {
    "node": "22.x"
  },
  "prisma": {
    "seed": "node --experimental-specifier-resolution=node prisma/seed.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aframeymi/CV.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aframeymi/CV/issues"
  },
  "homepage": "https://github.com/aframeymi/CV#readme",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "chart.js": "4.6.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "4.1.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.3",
    "firebase-admin": "^14.5.0",
    "helmet": "8.3.0",
    "multer": "^2.5.0",
    "prisma": "^6.19.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
