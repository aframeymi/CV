<!DOCTYPE html>
<html lang="en">
<%# Shared page head (stylesheet and page title) %>
<%- include('includes/head') %>



<body>
    <%# Shared navigation bar %>
    <%- include('includes/navbar') %>

<main class="main">
    <div id="content">
        <h1>WELCOME</h1>
        <img src="/pp.jpg" alt="profile-pic">
        
        <%# Login form: posts email and password to /api/login %>
        <form method="POST" action="/api/login">
            <input type="email" name="email" placeholder="Email" required />
            <input type="password" name="password" placeholder="Password" required />
            <input type="submit" value="Sign in" />
        </form>

        <%# Link to the registration page %>
        <p>New in here? <a href="/sign_up">SIGN UP</a></p>
    </div>
</main>
<%# Script with the profile menu toggle (callMenu) %>
<script src="/script.js"></script>

</body>
</html>