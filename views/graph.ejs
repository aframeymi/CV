<!DOCTYPE html>
<html lang="en">
<%# Shared page head (stylesheet and page title) %>
<%- include('includes/head') %>

<body>
    <%# Shared navigation bar %>
    <%- include('includes/navbar') %>

<%# Bar chart: busiest neighborhoods (drawn from live data by graph.js) %>
<div class="graph-container">
    <div class="graph">
        <canvas id="neighborhoodChart" width="400" height="300" class="chart-canvas"></canvas>
    </div>
</div>  
<%# Pie chart: reports by status (drawn from live data by graph.js) %>
<div class="piechart-container">
    <div class="piechart">
        <canvas id="statusChart" width="400" height="300" class="chart-canvas"></canvas>
    </div>
</div>
<%# Map of Berlin %>
<div class="map-container">
    <iframe class="map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d313275.8136508344!2d13.0951001857
    5723!3d52.506386175110244!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a84e373f035901%3A0x4
    2120465b5e3b70!2sBerlin!5e1!3m2!1sen!2sde!4v1740049865470!5m2!1sen!2sde" width="50%" height="350px" 
    allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>


<%# Chart.js, served by this site from the installed npm package, then the code that draws the charts %>
<script src="/vendor/chart.umd.js"></script>
<script src="/graph.js"></script>
<%# Script with the profile menu toggle %>
<script src="/script.js"></script>

</body>
</html>