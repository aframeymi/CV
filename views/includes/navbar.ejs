<div class="navbar">
  <a href="/" class="image"><img src="/logo.png" width="50px" height="50px" alt="logo"></a>

  <div class="navlinks">
    <a href="/" class="navhome">Home</a>
    <a href="/report" class="naverep">Report</a>
    <a href="/track" class="navtra">Track</a>
    <a href="/graph">Graph</a>

    <% if (typeof user !== 'undefined' && user) { %>
    <% } else { %>
      <a href="/sign_in">Login</a>
      <a href="/sign_up">Register</a>
    <% } %>
  </div>

  <div class="dropdown">
    <a href="#" class="navprofile" data-toggles-menu>
      <img src="/pp.jpg" alt="profile-pic">
    </a>

    <a href="#" id="navprofile" class="navprofile" data-toggles-menu>
      <%= (typeof user !== 'undefined' && user)
          ? (user.name || user.email || 'User')
          : 'User' %>
    </a>

    <div id="hiddenLinks" class="dropdown-content">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/profile">Profile</a>
        <a href="/settings">Setting</a>
        <form method="POST" action="/api/logout" class="logout-form">
          <%- include('csrf-field') %>
          <button type="submit" class="linklike">
            Logout
          </button>
        </form>
      <% } else { %>
        <a href="/sign_in">Sign in</a>
        <a href="/sign_up">Sign up</a>
      <% } %>
    </div>
  </div>
</div>
