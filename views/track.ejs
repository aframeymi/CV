<!DOCTYPE html>
<html lang="en">

<%# Shared page head (stylesheet and page title) %>
<%- include('includes/head') %>

<body>

    <%# Shared navigation bar %>
    <%- include('includes/navbar') %>


<div class="trackbody">
    <h1>
        <img class="bonus" src="/bonus.png" width="80px" height="80px">
    </h1>
    <h2 class="tracktext"> 
        Your report was successfully submitted.
        <br>
        You recieved 50 bonus points.
    </h2>
</div>

<%# Progress tracker: Received, In Process, Processed (static, not linked to real report status) %>
<div class="progress-container">
    <div class="step">
        <div class="circle">
            <img src="/icon1.png" alt="Received">
        </div>
        <div class="label">Received</div>
    </div>
    <div class="line"></div>
    <div class="step">
        <div class="circle">
            <img src="/icon2.png" alt="In Process">
        </div>
        <div class="label">In Process</div>
    </div>
    <div class="line"></div>
    <div class="step">
        <div class="circle">
            <img src="/icon3.png" alt="Processed">
        </div>
        <div class="label">Processed</div>
    </div>
</div>
<br>

<%# One page of reports, newest first (20 per page, see src/services/report-listing.js) %>
<div class="report-section">
    <ul>
    
    <%# Loop: one card per report %>    
    <% reports.forEach(report => { %>
        <li class="report-card">
            <div>
            <div>
            <img class="report-img" src="<%= report.imageUrl || '/seo-report.png' %>" alt="Photo of the reported problem">
            </div>
            Title: <%= report.title %>
            <br>
            <br>
            Description: <%= report.description %>
            <br>

            <%# Edit button: opens the edit page for this report %>
            <form action="/track/<%= report.id %>/edit" method="GET" class="inline-form">
                <button class="edit" type="submit">Edit</button>
              </form>

              <%# Delete button: sends a POST to delete this report %>
              <form action="/track/<%= report.id %>/delete" method="POST" class="inline-form">
                <%- include('includes/csrf-field') %>
                <button class="delete" type="submit">Delete</button>
              </form>
            </div>
        </li>
    <% }); %>
    </ul>

    <%# Page links: page 1 holds the newest reports %>
    <nav class="pagination" aria-label="Report pages">
        <% if (page > 1) { %><a href="/track?page=<%= page - 1 %>">Newer reports</a><% } %>
        <span>Page <%= page %> of <%= pageCount %></span>
        <% if (page < pageCount) { %><a href="/track?page=<%= page + 1 %>">Older reports</a><% } %>
    </nav>
</div>
<div class="simloc">
    <img src="/map.png" alt="Map" width="40%">
</div>
<h3 class="simloctext">
    234 more similar reports in your area.
</h3>    

<%# Script with the profile menu toggle %>
<script src="/script.js"></script>

</body>
</html>